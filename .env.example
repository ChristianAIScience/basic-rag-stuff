# Copy this file to .env and fill in your values: cp .env.example .env

# --- PostgreSQL (matches docker-compose.yml) ---
POSTGRES_HOST=localhost
# Use another port (e.g. 5433) if a local PostgreSQL already listens on 5432
POSTGRES_PORT=5432
POSTGRES_DB=rag_learning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# --- OpenAI ---
LLM_API_KEY=your_openai_api_key
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-5-mini
# Model that grades answers in examples.evaluate_rag (LLM-as-a-judge); defaults to LLM_MODEL
# JUDGE_MODEL=gpt-5-mini

# --- MLflow (docker-compose service "mlflow") ---
# If something else already listens on 5000, change BOTH lines to the same free port (e.g. 5001):
# MLFLOW_PORT is where Docker publishes the server, MLFLOW_TRACKING_URI is where the code connects.
MLFLOW_PORT=5000
# Leave empty to run the examples without MLflow.
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Optional (defaults shown) ---
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# VECTOR_TABLE=documents
# VECTOR_SIZE=1536   # must match the embedding model (text-embedding-3-small = 1536)
